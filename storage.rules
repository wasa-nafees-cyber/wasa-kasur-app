rules_version = '2';
// WASA app - Firebase Storage rules (Firebase Console > Storage > Rules)
// Same situation as firestore.rules: no Firebase Authentication yet, so these
// rules cannot tell officers and admin apart. Open for now - see INSPECTION_NOTES.txt.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{file} { allow read, write: if true; }
  }
}
